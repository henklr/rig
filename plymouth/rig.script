# The disk password prompt at boot, made to look like config/hypr/hyprlock.conf,
# so change them together. Plymouth has no clock, which is the only difference.
# install/setup.sh fills in the username: the initramfs has no user database.
# It has no locale either, so text must be ASCII and the dots are images.

username = "@USER@";
max_dots = 20;
dot_pitch = 14;
bullets = 0;

Window.SetBackgroundTopColor (0.078, 0.078, 0.086);
Window.SetBackgroundBottomColor (0.078, 0.078, 0.086);

fun text (string, size, gray)
  {
    return Sprite (Image.Text (string, gray, gray, gray, 1, "JetBrainsMono Nerd Font " + size));
  }

fun place (sprite, x, y)
  {
    local.image = sprite.GetImage ();
    sprite.SetPosition (x - image.GetWidth () / 2, y - image.GetHeight () / 2, 10);
  }

fun dialog_setup ()
  {
    global.dialog.name = text (global.username, "24", 0.9);
    global.dialog.field = Sprite (Image ("field.png"));
    global.dialog.placeholder = text ("Password", "13", 0.54);

    local.dot = Image ("dot.png");
    for (index = 0; index < global.max_dots; index++)
      global.dialog.dots[index] = Sprite (dot);
  }

# Screens can appear after this script has started, and every screen is centered
# in the largest one, so the middle has to be measured each time.
fun dialog_place ()
  {
    local.x = Window.GetX () + Window.GetWidth () / 2;
    local.y = Window.GetY () + Window.GetHeight () / 2;

    place (dialog.name, x, y - 50);
    place (dialog.field, x, y + 20);
    place (dialog.placeholder, x, y + 20);
    for (index = 0; index < global.max_dots; index++)
      place (dialog.dots[index], x + global.dot_pitch * (index - (global.bullets - 1) / 2), y + 20);
  }

fun dialog_opacity (opacity)
  {
    dialog.name.SetOpacity (opacity);
    dialog.field.SetOpacity (opacity);

    if (global.bullets == 0)
      dialog.placeholder.SetOpacity (opacity);
    else
      dialog.placeholder.SetOpacity (0);

    for (index = 0; index < global.max_dots; index++)
      if (index < global.bullets)
        dialog.dots[index].SetOpacity (opacity);
      else
        dialog.dots[index].SetOpacity (0);
  }

fun display_password_callback (prompt, count)
  {
    if (!global.dialog)
      dialog_setup ();

    global.bullets = Math.Min (count, global.max_dots);
    dialog_place ();
    dialog_opacity (1);
  }

fun display_normal_callback ()
  {
    if (global.dialog)
      dialog_opacity (0);
  }

fun display_hotplug_callback ()
  {
    if (global.dialog)
      dialog_place ();
  }

Plymouth.SetDisplayPasswordFunction (display_password_callback);
Plymouth.SetDisplayNormalFunction (display_normal_callback);
Plymouth.SetDisplayHotplugFunction (display_hotplug_callback);
