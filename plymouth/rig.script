# The disk password prompt at boot, made to look like config/hypr/hyprlock.conf,
# so change them together. Plymouth has no clock, which is the only difference.
# install/setup.sh fills in the username: the initramfs has no user database.

username = "@USER@";

Window.SetBackgroundTopColor (0.078, 0.078, 0.086);
Window.SetBackgroundBottomColor (0.078, 0.078, 0.086);

center_x = Window.GetX () + Window.GetWidth () / 2;
center_y = Window.GetY () + Window.GetHeight () / 2;

field.width = 300;
field.height = 48;
field.border = 2;
field.x = center_x - field.width / 2;
field.y = center_y + 20 - field.height / 2;
field.z = 10;

fun text (string, size, gray)
  {
    return Image.Text (string, gray, gray, gray, 1, "JetBrainsMono Nerd Font " + size);
  }

fun place_centered (sprite, image, y)
  {
    sprite.SetImage (image);
    sprite.SetPosition (center_x - image.GetWidth () / 2, y - image.GetHeight () / 2, field.z + 1);
    sprite.SetOpacity (1);
  }

fun border_line (x, y, width, height)
  {
    local.pixel = Image ("pixel.png");
    local.sprite = Sprite (pixel.Scale (width, height));
    sprite.SetPosition (x, y, field.z);
    return sprite;
  }

fun dialog_setup ()
  {
    local.lines;
    lines[0] = border_line (field.x, field.y, field.width, field.border);
    lines[1] = border_line (field.x, field.y + field.height - field.border, field.width, field.border);
    lines[2] = border_line (field.x, field.y, field.border, field.height);
    lines[3] = border_line (field.x + field.width - field.border, field.y, field.border, field.height);

    local.name = Sprite ();
    place_centered (name, text (global.username, "24", 0.9), global.center_y - 50);

    global.dialog.lines = lines;
    global.dialog.name = name;
    global.dialog.placeholder = Sprite ();
    global.dialog.dots = Sprite ();
    place_centered (global.dialog.placeholder, text ("Password", "13", 0.54), global.center_y + 20);
  }

fun dialog_opacity (opacity)
  {
    for (index = 0; index < 4; index++)
      dialog.lines[index].SetOpacity (opacity);
    dialog.name.SetOpacity (opacity);
    dialog.placeholder.SetOpacity (opacity);
    dialog.dots.SetOpacity (opacity);
  }

fun display_password_callback (prompt, bullets)
  {
    if (!global.dialog)
      dialog_setup ();
    dialog_opacity (1);

    if (bullets == 0)
      {
        dialog.dots.SetOpacity (0);
      }
    else
      {
        dots = "";
        for (index = 0; index < bullets && index < 24; index++)
          dots = dots + "•";
        dialog.placeholder.SetOpacity (0);
        place_centered (dialog.dots, text (dots, "16", 0.9), global.center_y + 20);
      }
  }

fun display_normal_callback ()
  {
    if (global.dialog)
      dialog_opacity (0);
  }

Plymouth.SetDisplayPasswordFunction (display_password_callback);
Plymouth.SetDisplayNormalFunction (display_normal_callback);
